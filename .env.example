# Copy this file to a local .env and set your own TypeSafe JEV API key.
# Keep .env private; leave the value empty for mock mode.
# To use real mode, replace the empty value with your own key.
JEV_API_KEY=
# Set two different, privately generated values before using the HTTP API.
# Never provide the approval token to an Agent or MCP client.
PERMITMCP_EXECUTION_TOKEN=
PERMITMCP_APPROVAL_TOKEN=
